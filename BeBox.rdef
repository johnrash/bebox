/* BeBox emulator - application resources. */

resource app_signature "application/x-vnd.BeBox-Emulator";

/* One instance; later launches deliver their arguments (ArgvReceived). */
resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 1,
	short_info = "BeBox",
	long_info = "An emulator of the Be BeBox (Dual603-66 and Dual603e-133)."
};

/* artwork/BeBox.hvif is generated by tools/make_icon.py. */
resource(101, "BEOS:ICON") #'VICN' import "artwork/BeBox.hvif";

/* Haiku's own icons (MIT, from the Haiku icon set) for things Haiku has
   no application or preference for. */
resource(201, "joystick") #'VICN' import "artwork/icons/Prefs_Joystick.hvif";
resource(202, "floppy") #'VICN' import "artwork/icons/Device_Floppy.hvif";
resource(203, "cd") #'VICN' import "artwork/icons/Device_CD.hvif";
resource(204, "harddisk") #'VICN' import "artwork/icons/Device_Harddisk.hvif";
/* Prefs_VirtualMemory with Overlay_Be on top (tools/merge_hvif.py). */
resource(205, "machine") #'VICN' import "artwork/icons/Machine.hvif";
